# Server-only provider keys. Leave blank for the non-billable illustrative example.
ANTHROPIC_API_KEY=
# Default: claude-sonnet-5-5 (must support structured outputs).
ANTHROPIC_MODEL=
SARVAM_API_KEY=
# Default: bulbul:v4-flash. Legacy compatibility: bulbul:v3.
SARVAM_TTS_MODEL=
# Default v4 voice: shubh_enhi_companion. Must match the chosen model.
SARVAM_TTS_SPEAKER=
# Local defaults: port 3000, host 127.0.0.1. Do not bind publicly for local testing.
PORT=
HOST=
# Exact browser origin; default http://localhost:3000. No path or trailing slash.
APP_ORIGIN=
# Process-wide hourly cap (300); per-connection ten-minute cap (60); concurrency (4).
# Behind an untrusted proxy/event Wi-Fi, participants may share the connection limit.
MAX_REQUESTS_PER_HOUR=
MAX_REQUESTS_PER_IP_10_MIN=
MAX_CONCURRENT_REQUESTS=
